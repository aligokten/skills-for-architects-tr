{
  "path": "skills/proposal/SKILL.md",
  "responsibility": "Proje tekliflerini hazırlar ve kaydeder (Mimarlar Odası en az bedel esasları, yapı sınıfı ve Yapı Yaklaşık Birim Maliyetleri dikkate alınarak), verilmiş koşulları korur ve açıkça belgelenen ticari değişiklikleri kaydeder. Mesaj göndermek ayrı yetki gerektirir.",
  "inputs": "Supplied task and selected source scope; exact destination only for requested persistence or application work. Load project context only when the task needs project records.",
  "owned_records": [
    "DOCUMENTS.csv (kind=proposal)"
  ],
  "non_owned_records": [
    "PROJECT.md",
    "STUDIO.md",
    "TASKS.csv",
    "TIME.csv",
    "PROJECT.md#agreement and registered agreement/contract documents",
    "INVOICES.csv",
    "ffe/items-and-schedules",
    "product-library.csv",
    "epd-library.csv",
    "ffe/jobs/input-manifests"
  ],
  "delegation": "inherit-scope-target-permissions-and-evidence",
  "modes": [
    {
      "mode": "record-read",
      "required": [
        "file.read"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "record-write",
      "required": [
        "file.read",
        "file.write"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "delegate"
    }
  ],
  "execution": {
    "model": "harness-native",
    "contract": "docs/workspace-model.md",
    "operations": [
      "context.resolve",
      "proposal.create",
      "proposal.list",
      "proposal.verify",
      "proposal.status",
      "proposal.send",
      "proposal.set-status"
    ]
  }
}
